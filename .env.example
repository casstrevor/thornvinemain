# Client (Vite) — safe to expose in the browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Never put the database password in VITE_* vars or commit it.
# Prefer Supabase MCP for schema/SQL; use `supabase link` locally if needed.

# Edge function intake-turn only. Do not prefix these with VITE_.
# INTAKE_MODEL_API_KEY=
# INTAKE_MODEL_URL=
# INTAKE_MODEL_NAME=
